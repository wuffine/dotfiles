[global]
	follow = mouse
	width = 300
	height = (0, 300)
	origin = bottom-right
	offset = (10, 10)
	scale = 0
	word_wrap = true
	notification_limit = 20
	progress_bar = true
	progress_bar_height = 10
	progress_bar_frame_width = 0
	progress_bar_min_width = 150
	progress_bar_max_width = 300
	progress_bar_corner_radius = 0
	icon_corner_radius = 0
	icon_theme = "Papirus-Dark"
	indicate_hidden = true
	separator_height = 2
	padding = 12
	horizontal_padding = 12
	text_icon_padding = 12
	frame_width = 0
	gap_size = 5
	frame_color = "#67b0e8"
	separator_color = auto
	sort = true
	font = Monospace 10
	line_height = 0
	markup = full
	format = "<b>%a</b>\n<i>%s</i>\n%b"
	alignment = left
	vertical_alignment = center
	ellipsize = middle
	ignore_newline = false
	stack_duplicates = true
	hide_duplicate_count = false
	show_indicators = yes
	icon_theme = Adwaita
	icon_position = left
	min_icon_size = 48
	max_icon_size = 64
	corner_radius = 0
	layer = top
	force_xwayland = false
	mouse_left_click = close_current
	mouse_middle_click = do_action, close_current
	mouse_right_click = close_all

[fullscreen_delay_everything]
	fullscreen = delay

[fullscreen_show_critical]
	msg_urgency = critical
	fullscreen = show

[urgency_low]
	background = "#141b1e"
	foreground = "#dadada"
	highlight = "#8ccf7e"
	frame_color = "#67b0e8"
	timeout = 2

[urgency_normal]
	background = "#141b1e"
	foreground = "#dadada"
	highlight = "#8ccf7e"
	frame_color = "#67b0e8"
	timeout = 2

[urgency_critical]
	background = "#141b1e"
	foreground = "#dadada"
	highlight = "#8ccf7e"
	frame_color = "#e57474"
	timeout = 10

[volumeosd]
	appname = "Volume"
	format = "<b>%s</b>\n%b"
	min_icon_size = 32
	max_icon_size = 128
	timeout = 2
	set_transient = no

[musicosd]
	appname = "Music"
	format = "<b>%s</b>\n<i>%b</i>"
	history_ignore = yes
	min_icon_size = 48
	max_icon_size = 128
	timeout = 2
